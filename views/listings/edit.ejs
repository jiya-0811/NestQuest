<% layout('layouts/boilerplate') %>

<div class="row justify-content-center mt-5">
  <div class="col-md-6">

    <div class="card shadow-lg border-0 rounded-3 p-4">

      <h3 class="mb-3 text-center fw-bold">✏ Edit Rental</h3>
      <p class="text-muted text-center">Update listing details</p>

      <form
        action="/listings/<%= listing._id %>?_method=PUT"
        method="POST"
        enctype="multipart/form-data"
      >

        <!-- TITLE -->
        <div class="mb-3">
          <label class="form-label">Title</label>
          <input
            type="text"
            name="listing[title]"
            class="form-control"
            value="<%= listing.title %>"
            required
          >
        </div>


        <!-- DESCRIPTION -->
        <div class="mb-3">
          <label class="form-label">Description</label>
          <textarea
            name="listing[description]"
            class="form-control"
            rows="3"
            required
          ><%= listing.description %></textarea>
        </div>


        <!-- PRICE -->
        <div class="mb-3">
          <label class="form-label">Price (₹)</label>
          <input
            type="number"
            name="listing[price]"
            class="form-control"
            value="<%= listing.price %>"
            min="1"
            required
          >
        </div>


        <!-- LOCATION -->
        <div class="mb-3">
          <label class="form-label">City</label>
          <input
            type="text"
            name="listing[location]"
            class="form-control"
            value="<%= listing.location %>"
            required
          >
        </div>


        <!-- COUNTRY -->
        <div class="mb-3">
          <label class="form-label">Country</label>
          <input
            type="text"
            name="listing[country]"
            class="form-control"
            value="<%= listing.country %>"
            required
          >
        </div>


        <!-- COLLEGE -->
        <div class="mb-3">
          <label class="form-label">Nearby College</label>
          <input
            type="text"
            name="listing[college]"
            class="form-control"
            value="<%= listing.college %>"
            required
          >
        </div>


        <!-- TYPE -->
        <div class="mb-3">
          <label class="form-label">Type</label>

          <select
            name="listing[type]"
            class="form-control"
            required
          >
            <option value="">Select</option>

            <option
              value="shared"
              <%= listing.type === "shared" ? "selected" : "" %>
            >
              Shared Room
            </option>

            <option
              value="single"
              <%= listing.type === "single" ? "selected" : "" %>
            >
              Single Room
            </option>

            <option
              value="flat"
              <%= listing.type === "flat" ? "selected" : "" %>
            >
              Flat
            </option>

          </select>
        </div>


        <!-- DISTANCE -->
        <div class="mb-3">
          <label class="form-label">
            Distance from College (km)
          </label>

          <input
            type="number"
            name="listing[distance]"
            class="form-control"
            value="<%= listing.distance %>"
            min="0"
            required
          >
        </div>


        <!-- CURRENT IMAGE -->
        <div class="mb-4">

          <label class="form-label fw-semibold">
            Current Image
          </label>

          <% if (listing.image && listing.image.url) { %>

            <div class="mb-3">
              <img
                src="<%= listing.image.url %>"
                alt="Current listing image"
                class="img-fluid rounded-3 shadow-sm"
                style="max-height: 220px; width: 100%; object-fit: cover;"
              >
            </div>

          <% } %>


          <!-- NEW IMAGE -->
          <label class="form-label fw-semibold">
            Replace Image
          </label>

          <input
            type="file"
            name="image"
            class="form-control"
            accept="image/png, image/jpeg, image/jpg, image/webp"
          >

          <div class="form-text">
            Leave empty if you want to keep the current image.
          </div>

        </div>


        <!-- AMENITIES -->
        <div class="mb-4">

          <label class="form-label">
            Amenities
          </label>


          <!-- WIFI -->
          <div class="form-check">

            <input
              class="form-check-input"
              type="checkbox"
              name="listing[amenities][]"
              value="wifi"
              <%= listing.amenities.includes("wifi") ? "checked" : "" %>
            >

            <label class="form-check-label">
              WiFi
            </label>

          </div>


          <!-- FOOD -->
          <div class="form-check">

            <input
              class="form-check-input"
              type="checkbox"
              name="listing[amenities][]"
              value="food"
              <%= listing.amenities.includes("food") ? "checked" : "" %>
            >

            <label class="form-check-label">
              Food
            </label>

          </div>


          <!-- PARKING -->
          <div class="form-check">

            <input
              class="form-check-input"
              type="checkbox"
              name="listing[amenities][]"
              value="parking"
              <%= listing.amenities.includes("parking") ? "checked" : "" %>
            >

            <label class="form-check-label">
              Parking
            </label>

          </div>


          <!-- LAUNDRY -->
          <div class="form-check">

            <input
              class="form-check-input"
              type="checkbox"
              name="listing[amenities][]"
              value="laundry"
              <%= listing.amenities.includes("laundry") ? "checked" : "" %>
            >

            <label class="form-check-label">
              Laundry
            </label>

          </div>

        </div>


        <!-- BUTTON -->
        <div class="d-grid">

          <button
            type="submit"
            class="btn btn-dark btn-lg"
          >
            Update Listing 🚀
          </button>

        </div>

      </form>

    </div>

  </div>
</div>