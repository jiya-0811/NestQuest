<% layout('layouts/boilerplate') %>

<style>
  .listing-show-page {
    background: #f8f9fa;
    min-height: 100vh;
    padding-bottom: 60px;
  }

  .main-listing-card {
    border: none;
    border-radius: 20px;
    overflow: hidden;
  }

  .listing-image {
    width: 100%;
    height: 100%;
    min-height: 470px;
    object-fit: cover;
  }

  .price-text {
    color: #ff385c;
  }

  .info-item {
    background: #f8f9fa;
    border-radius: 12px;
    padding: 12px 15px;
    margin-bottom: 10px;
  }

  .amenity-badge {
    background: white;
    border: 1px solid #dee2e6;
    border-radius: 20px;
    padding: 8px 14px;
  }

  /* ==========================================
     OWNER / CONTACT CARD
     ========================================== */

  .owner-card {
    border: none;
    border-radius: 20px;
    overflow: hidden;
    background: white;
  }

  .owner-header {
    background: linear-gradient(135deg, #212529, #343a40);
    color: white;
    padding: 20px 25px;
  }

  .owner-avatar {
    width: 65px;
    height: 65px;
    border-radius: 50%;
    background: #ffe8ed;
    color: #ff385c;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    font-weight: bold;
    flex-shrink: 0;
  }

  .owner-info {
    background: #f8f9fa;
    border-radius: 14px;
    padding: 15px;
  }

  .owner-contact-btn {
    background: #ff385c;
    color: white;
    border: none;
    border-radius: 12px;
    padding: 12px 20px;
    font-weight: 600;
    transition: 0.2s ease;
  }

  .owner-contact-btn:hover {
    background: #e03150;
    color: white;
    transform: translateY(-1px);
  }

  .owner-email {
    word-break: break-word;
  }

  .owner-badge {
    background: #e9ecef;
    color: #495057;
    border-radius: 10px;
    padding: 10px 14px;
  }

  .review-card {
    border: none;
    border-radius: 16px;
  }

  .star-rating {
    letter-spacing: 2px;
  }
</style>

<div class="listing-show-page">

  <div class="container pt-5">

```
<!-- ========================================== -->
<!-- MAIN LISTING CARD -->
<!-- ========================================== -->

<div class="card shadow-lg main-listing-card">

  <div class="row g-0">

    <!-- IMAGE -->

    <div class="col-md-6">

      <img
        src="<%= listing.image?.url || 'https://images.unsplash.com/photo-1505693416388-ac5ce068fe85' %>"
        class="listing-image"
        alt="<%= listing.title %>"
      >

    </div>


    <!-- LISTING INFORMATION -->

    <div class="col-md-6">

      <div class="p-4 p-md-5">

        <h1 class="fw-bold mb-2">
          <%= listing.title %>
        </h1>

        <p class="text-muted fs-5 mb-4">
          📍 <%= listing.location || "Location not specified" %>
        </p>


        <!-- PRICE -->

        <div class="mb-4">

          <span class="fw-bold fs-2 price-text">
            ₹<%= listing.price %>
          </span>

          <span class="text-muted">
            / month
          </span>

        </div>


        <!-- COLLEGE -->

        <div class="info-item">

          <div class="fw-semibold">
            🎓 College
          </div>

          <div class="text-muted">
            <%= listing.college || "College not specified" %>
          </div>

        </div>


        <!-- DISTANCE -->

        <div class="info-item">

          <div class="fw-semibold">
            📍 Distance from College
          </div>

          <div class="text-muted">
            <%= listing.distance ?? "?" %> km
          </div>

        </div>


        <!-- TYPE -->

        <% if(listing.type){ %>

          <div class="info-item">

            <div class="fw-semibold">
              🏠 Rental Type
            </div>

            <div class="text-muted text-capitalize">
              <%= listing.type %>
            </div>

          </div>

        <% } %>


        <!-- BADGES -->

        <div class="mb-4 mt-3">

          <% if(listing.price && listing.price <= 5000){ %>

            <span class="badge bg-success me-1 p-2">
              💰 Budget Friendly
            </span>

          <% } %>


          <% if(
            listing.distance !== undefined &&
            listing.distance <= 2
          ){ %>

            <span class="badge bg-primary me-1 p-2">
              📍 Near College
            </span>

          <% } %>


          <% if(listing.type){ %>

            <span class="badge bg-info text-dark me-1 p-2">
              🏠 <%= listing.type %>
            </span>

          <% } %>

        </div>


        <hr>


        <!-- DESCRIPTION -->

        <h5 class="fw-bold mb-2">
          About this rental
        </h5>

        <p class="text-muted">
          <%= listing.description || "No description available." %>
        </p>


        <!-- AMENITIES -->

        <% if(listing.amenities && listing.amenities.length > 0){ %>

          <div class="mt-4">

            <h5 class="fw-bold mb-3">
              ✨ Amenities
            </h5>

            <div class="d-flex flex-wrap gap-2">

              <% listing.amenities.forEach(amenity => { %>

                <% if(amenity === "wifi"){ %>
                  <span class="amenity-badge">📶 WiFi</span>
                <% } %>

                <% if(amenity === "food"){ %>
                  <span class="amenity-badge">🍱 Food</span>
                <% } %>

                <% if(amenity === "parking"){ %>
                  <span class="amenity-badge">🅿️ Parking</span>
                <% } %>

                <% if(amenity === "laundry"){ %>
                  <span class="amenity-badge">🧺 Laundry</span>
                <% } %>

              <% }) %>

            </div>

          </div>

        <% } %>


        <!-- RATING -->

        <div class="mt-4">

          <h5 class="fw-bold">
            ⭐ Rating
          </h5>

          <% if(avgRating && avgRating > 0){ %>

            <p class="mb-0">

              <span class="fs-4 fw-bold">
                <%= avgRating %>
              </span>

              <span class="text-warning fs-4">
                ★
              </span>

              <span class="text-muted">
                / 5
              </span>

            </p>

          <% } else { %>

            <p class="text-muted">
              No ratings yet
            </p>

          <% } %>

        </div>


        <!-- ========================================== -->
        <!-- FAVORITE -->
        <!-- ========================================== -->

        <% if(currUser){ %>

          <div class="mt-4">

            <% if(isFavorite){ %>

              <form
                action="/listings/<%= listing._id %>/favorite?_method=DELETE"
                method="POST"
              >

                <button
                  type="submit"
                  class="btn btn-danger w-100"
                >
                  ❤️ Saved to Favorites
                </button>

              </form>

            <% } else { %>

              <form
                action="/listings/<%= listing._id %>/favorite"
                method="POST"
              >

                <button
                  type="submit"
                  class="btn btn-outline-danger w-100"
                >
                  🤍 Save to Favorites
                </button>

              </form>

            <% } %>

          </div>

        <% } %>


        <!-- ========================================== -->
        <!-- OWNER CONTROLS -->
        <!-- ========================================== -->

        <% if(
          currUser &&
          listing.owner &&
          currUser._id.equals(listing.owner._id)
        ){ %>

          <div class="mt-4 pt-3 border-top">

            <p class="text-muted mb-2">
              Owner Controls
            </p>

            <a
              href="/listings/<%= listing._id %>/edit"
              class="btn btn-warning me-2"
            >
              ✏️ Edit
            </a>

            <form
              action="/listings/<%= listing._id %>?_method=DELETE"
              method="POST"
              style="display:inline;"
            >

              <button class="btn btn-danger">
                🗑️ Delete
              </button>

            </form>

          </div>

        <% } %>

      </div>

    </div>

  </div>

</div>


<!-- ========================================== -->
<!-- CONTACT OWNER CARD -->
<!-- ========================================== -->

<% if(listing.owner){ %>

  <div class="card shadow-sm owner-card mt-4">

    <!-- HEADER -->

    <div class="owner-header">

      <div class="d-flex align-items-center">

        <div class="owner-avatar me-3">
          👤
        </div>

        <div>

          <h4 class="fw-bold mb-1">
            Contact the Owner
          </h4>

          <p class="mb-0 opacity-75">
            Interested in this rental? Get in touch directly.
          </p>

        </div>

      </div>

    </div>


    <!-- BODY -->

    <div class="card-body p-4">

      <% if(currUser){ %>


        <!-- ====================================== -->
        <!-- CURRENT USER IS OWNER -->
        <!-- ====================================== -->

        <% if(
          listing.owner &&
          currUser._id.equals(listing.owner._id)
        ){ %>

          <div class="owner-info text-center">

            <div class="fs-1 mb-2">
              👑
            </div>

            <h5 class="fw-bold mb-1">
              This is your listing
            </h5>

            <p class="text-muted mb-0">
              Other users can contact you through this listing.
            </p>

          </div>


        <!-- ====================================== -->
        <!-- OTHER LOGGED-IN USER -->
        <!-- ====================================== -->

        <% } else { %>

          <div class="row align-items-center">

            <div class="col-md-7 mb-3 mb-md-0">

              <div class="d-flex align-items-center">

                <div class="owner-avatar me-3">
                  <%= listing.owner.username
                    ? listing.owner.username.charAt(0).toUpperCase()
                    : "U" %>
                </div>

                <div>

                  <p class="text-muted mb-1">
                    Property Owner
                  </p>

                  <h5 class="fw-bold mb-1">
                    <%= listing.owner.username %>
                  </h5>

                  <p class="text-muted mb-0 owner-email">
                    📧 <%= listing.owner.email %>
                  </p>

                </div>

              </div>

            </div>


            <!-- CONTACT BUTTON -->

            <div class="col-md-5">

              <a
                href="mailto:<%= listing.owner.email %>?subject=Interested%20in%20your%20listing%20-%20<%= encodeURIComponent(listing.title) %>&body=Hi%20<%= encodeURIComponent(listing.owner.username) %>,%0A%0AI%20am%20interested%20in%20your%20listing%20%22<%= encodeURIComponent(listing.title) %>%22.%0A%0APlease%20let%20me%20know%20if%20it%20is%20still%20available.%0A%0AThank%20you!"
                class="btn owner-contact-btn w-100"
              >
                📩 Contact Owner
              </a>

              <p class="text-muted small text-center mt-2 mb-0">
                Opens your default email app
              </p>

            </div>

          </div>

        <% } %>


      <!-- ====================================== -->
      <!-- LOGGED OUT USER -->
      <!-- ====================================== -->

      <% } else { %>

        <div class="text-center py-3">

          <div class="fs-1 mb-2">
            🔐
          </div>

          <h5 class="fw-bold">
            Want to contact the owner?
          </h5>

          <p class="text-muted">
            Login to view owner details and contact them.
          </p>

          <a
            href="/login"
            class="btn btn-dark px-4"
          >
            🔐 Login to Contact Owner
          </a>

        </div>

      <% } %>

    </div>

  </div>

<% } %>


<!-- ========================================== -->
<!-- REVIEWS SECTION -->
<!-- ========================================== -->

<div class="row mt-5">

  <!-- ADD REVIEW -->

  <div class="col-md-5 mb-4">

    <div class="card shadow-sm border-0 rounded-4 p-4">

      <h4 class="fw-bold mb-3">
        ⭐ Leave a Review
      </h4>


      <% if(currUser){ %>

        <form
          action="/listings/<%= listing._id %>/reviews"
          method="POST"
        >

          <label class="form-label fw-semibold">
            Rating
          </label>

          <select
            name="review[rating]"
            class="form-select mb-3"
            required
          >

            <option value="">
              Select rating
            </option>

            <option value="5">
              ⭐⭐⭐⭐⭐ Excellent
            </option>

            <option value="4">
              ⭐⭐⭐⭐ Very Good
            </option>

            <option value="3">
              ⭐⭐⭐ Good
            </option>

            <option value="2">
              ⭐⭐ Average
            </option>

            <option value="1">
              ⭐ Poor
            </option>

          </select>


          <label class="form-label fw-semibold">
            Your Review
          </label>

          <textarea
            name="review[comment]"
            class="form-control mb-3"
            rows="4"
            placeholder="Share your experience..."
            required
          ></textarea>


          <button
            class="btn btn-dark w-100"
            type="submit"
          >
            Submit Review ⭐
          </button>

        </form>


      <% } else { %>

        <div class="text-center py-3">

          <p class="text-muted">
            Please login to leave a review.
          </p>

          <a
            href="/login"
            class="btn btn-dark"
          >
            Login
          </a>

        </div>

      <% } %>

    </div>

  </div>


  <!-- ALL REVIEWS -->

  <div class="col-md-7">

    <div class="card shadow-sm border-0 rounded-4 p-4">

      <h4 class="fw-bold mb-4">
        📝 Reviews
      </h4>


      <% if(listing.reviews && listing.reviews.length > 0){ %>

        <% listing.reviews.forEach(review => { %>

          <div class="review-card border-bottom pb-3 mb-3">

            <div class="d-flex justify-content-between">

              <div>

                <strong>
                  👤 <%= review.reviewer.username %>
                </strong>

                <div class="text-warning star-rating mt-1">

                  <% for(let i = 1; i <= 5; i++){ %>

                    <% if(i <= review.rating){ %>
                      ★
                    <% } else { %>
                      ☆
                    <% } %>

                  <% } %>

                </div>

              </div>


              <% if(
                currUser &&
                review.reviewer &&
                currUser._id.equals(review.reviewer._id)
              ){ %>

                <form
                  action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                  method="POST"
                >

                  <button
                    class="btn btn-outline-danger btn-sm"
                  >
                    Delete
                  </button>

                </form>

              <% } %>

            </div>


            <p class="text-muted mt-2 mb-0">
              <%= review.comment %>
            </p>

          </div>

        <% }) %>


      <% } else { %>

        <div class="text-center py-4">

          <p class="text-muted mb-0">
            No reviews yet. Be the first one! 🌟
          </p>

        </div>

      <% } %>

    </div>

  </div>

</div>
