<% layout('layouts/boilerplate') %>

<%
  const f = filters || {};
%>

<div class="container mt-4">

  <!-- ========================================== -->
  <!-- HEADER -->
  <!-- ========================================== -->

  <div class="d-flex justify-content-between align-items-center mb-4">

    <div>
      <h2 class="fw-bold">🏠 Available Rentals</h2>
      <p class="text-muted mb-0">
        Find the right stay for your college life
      </p>
    </div>

    <div>

      <% if(!currUser){ %>

        <a href="/login" class="btn btn-outline-primary me-2">
          Login
        </a>

        <a href="/signup" class="btn btn-primary me-2">
          Sign Up
        </a>

      <% } %>


      <!-- 🤖 AI SEARCH -->

      <a
        href="/listings/recommend/search"
        class="btn btn-dark me-2"
      >
        🤖 Smart Recommendation
      </a>


      <% if(currUser){ %>

        <a
          href="/listings/new"
          class="btn btn-primary"
        >
          ➕ Add Listing
        </a>

      <% } %>

    </div>

  </div>


  <!-- ========================================== -->
  <!-- BASIC SEARCH -->
  <!-- ========================================== -->

  <div class="card shadow-sm border-0 rounded-3 p-4 mb-5">

    <h5 class="fw-bold mb-1">
      🔍 Search Rentals
    </h5>

    <p class="text-muted mb-4">
      Quickly find listings using basic filters.
      For personalized recommendations, use Smart Recommendation.
    </p>


    <form
      action="/listings"
      method="GET"
      class="row g-3"
    >

      <!-- SEARCH -->

      <div class="col-md-4">

        <label class="form-label">
          Search
        </label>

        <input
          type="text"
          name="search"
          class="form-control"
          placeholder="Title, location or college"
          value="<%= f.search %>"
        >

      </div>


      <!-- BUDGET -->

      <div class="col-md-3">

        <label class="form-label">
          Max Budget (₹)
        </label>

        <input
          type="number"
          name="budget"
          class="form-control"
          placeholder="e.g. 6000"
          min="1"
          value="<%= f.budget %>"
        >

      </div>


      <!-- TYPE -->

      <div class="col-md-2">

        <label class="form-label">
          Type
        </label>

        <select
          name="type"
          class="form-select"
        >

          <option value="">
            Any
          </option>

          <option
            value="single"
            <%= f.type === "single" ? "selected" : "" %>
          >
            Single
          </option>

          <option
            value="shared"
            <%= f.type === "shared" ? "selected" : "" %>
          >
            Shared
          </option>

          <option
            value="flat"
            <%= f.type === "flat" ? "selected" : "" %>
          >
            Flat
          </option>

        </select>

      </div>


      <!-- SORT -->

      <div class="col-md-3">

        <label class="form-label">
          Sort By
        </label>

        <select
          name="sort"
          class="form-select"
        >

          <option value="">
            Latest
          </option>

          <option
            value="priceLow"
            <%= f.sort === "priceLow" ? "selected" : "" %>
          >
            Price: Low → High
          </option>

          <option
            value="priceHigh"
            <%= f.sort === "priceHigh" ? "selected" : "" %>
          >
            Price: High → Low
          </option>

          <option
            value="distance"
            <%= f.sort === "distance" ? "selected" : "" %>
          >
            Nearest College
          </option>

        </select>

      </div>


      <!-- BUTTONS -->

      <div class="col-12 d-flex gap-2">

        <button
          type="submit"
          class="btn btn-primary flex-grow-1"
        >
          🔍 Search Rentals
        </button>

        <a
          href="/listings"
          class="btn btn-outline-secondary"
        >
          🔄 Clear
        </a>

      </div>

    </form>

  </div>


  <!-- ========================================== -->
  <!-- RESULT COUNT -->
  <!-- ========================================== -->

  <div class="d-flex justify-content-between align-items-center mb-3">

    <h5 class="fw-bold mb-0">
      🏠 Available Rentals
    </h5>

    <span class="badge bg-dark">
      <%= allListings.length %>
      result<%= allListings.length !== 1 ? "s" : "" %>
    </span>

  </div>


  <!-- ========================================== -->
  <!-- LISTINGS -->
  <!-- ========================================== -->

  <div class="row">

    <% if(allListings.length === 0){ %>

      <div class="col-12">

        <div class="text-center py-5">

          <h4>
            No listings found 😢
          </h4>

          <p class="text-muted">
            Try changing your search filters.
          </p>

          <a
            href="/listings"
            class="btn btn-dark"
          >
            View All Rentals
          </a>

        </div>

      </div>

    <% } %>


    <% allListings.forEach(listing => { %>

      <div class="col-md-4 mb-4">

        <div class="card shadow-sm h-100 border-0">

          <!-- IMAGE -->

          <img
            src="<%= listing.image?.url || 'https://images.unsplash.com/photo-1506744038136-46273834b3fb' %>"
            class="card-img-top"
            style="height:200px; object-fit:cover;"
            alt="<%= listing.title %>"
          >


          <div class="card-body d-flex flex-column">

            <!-- TITLE -->

            <h5 class="card-title fw-bold">
              <%= listing.title %>
            </h5>


            <!-- LOCATION -->

            <p class="text-muted mb-1">
              📍 <%= listing.location %>
            </p>


            <!-- PRICE -->

            <p class="mb-1 fw-semibold">
              💰 ₹ <%= listing.price %>
            </p>


            <!-- COLLEGE -->

            <p class="text-muted mb-2">
              🎓 <%= listing.distance %> km from
              <b><%= listing.college %></b>
            </p>


            <!-- BADGES -->

            <div class="mb-3">

              <% if(listing.type){ %>

                <span class="badge bg-info text-dark">
                  <%= listing.type %>
                </span>

              <% } %>


              <% if(listing.distance <= 2){ %>

                <span class="badge bg-success">
                  Near College
                </span>

              <% } %>


              <% if(listing.price <= 5000){ %>

                <span class="badge bg-warning text-dark">
                  Budget
                </span>

              <% } %>

            </div>


            <!-- VIEW -->

            <a
              href="/listings/<%= listing._id %>"
              class="btn btn-primary btn-sm mt-auto w-100"
            >
              View Details →
            </a>

          </div>

        </div>

      </div>

    <% }) %>

  </div>

</div>