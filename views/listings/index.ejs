<% layout('layouts/boilerplate') %>
<%- include('../includes/flash') %>

<!-- HEADER -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2>🏠 Available Rentals</h2>
    <p class="text-muted">Find best stays for students</p>
  </div>

  <div>
    <!-- LOGIN/SIGNUP -->
    <% if(!currUser){ %>
      <a href="/login" class="btn btn-outline-primary me-2">Login</a>
      <a href="/signup" class="btn btn-primary me-2">Sign Up</a>
    <% } %>

    <!-- AI SEARCH + ADD LISTING ALWAYS VISIBLE -->
    <a href="/listings/recommend/search?budget=5000&location=Indore" class="btn btn-dark me-2">
      🤖 AI Search
    </a>

    <% if(currUser){ %>
      <a href="/listings/new" class="btn btn-primary">
        ➕ Add Listing
      </a>
    <% } %>
  </div>
</div>

<!-- LISTINGS GRID -->
<div class="row">
  <% if(allListings.length === 0){ %>
    <div class="col-12">
      <p class="text-muted">No listings found 😢</p>
    </div>
  <% } %>

  <% allListings.forEach(listing => { %>
    <div class="col-md-4 mb-4">
      <div class="card shadow-sm h-100">

        <img 
          src="<%= listing.image?.url || 'https://images.unsplash.com/photo-1506744038136-46273834b3fb' %>" 
          class="card-img-top"
          style="height:200px; object-fit:cover;"
        >

        <div class="card-body d-flex flex-column">

          <h5 class="card-title"><%= listing.title %></h5>

          <p class="text-muted mb-1">📍 <%= listing.location %></p>

          <p class="mb-1">💰 ₹ <%= listing.price %></p>

          <p class="text-muted mb-2">
            🎓 <%= listing.distance %> km from <b><%= listing.college %></b>
          </p>

          <div class="mb-2">
            <% if(listing.type){ %>
              <span class="badge bg-info"><%= listing.type %></span>
            <% } %>

            <% if(listing.distance <= 2){ %>
              <span class="badge bg-success">Near College</span>
            <% } %>
          </div>

          <a href="/listings/<%= listing._id %>" class="btn btn-primary btn-sm mt-auto">
            View
          </a>

        </div>
      </div>
    </div>
  <% }) %>
</div>